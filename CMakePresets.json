{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LOG_LEVEL": "0"
      }
    },
    {
        "name": "release",
        "displayName": "Release",
        "generator": "Unix Makefiles",
        "binaryDir": "build/release",
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Release",
            "LOG_LEVEL": "2"
        }
    },
    {
        "name": "profile",
        "displayName": "Profile",
        "generator": "Unix Makefiles",
        "binaryDir": "build/profile",
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "RelWithDebInfo",
            "LOG_LEVEL": "6",
            "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -fno-omit-frame-pointer -fno-optimize-sibling-calls"
        }
    }
  ]
}